      type network = :VISA | :MASTERCARD

      module Network
        extend Lithic::Internal::Type::Enum

        VISA: :VISA
        MASTERCARD: :MASTERCARD

        def self?.values: -> ::Array[Lithic::Models::DisputeV2::network]
