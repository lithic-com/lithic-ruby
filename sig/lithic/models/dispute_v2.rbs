            module Stage
              extend Lithic::Internal::Type::Enum

              CHARGEBACK: :CHARGEBACK
              REPRESENTMENT: :REPRESENTMENT
              PREARBITRATION: :PREARBITRATION
              ARBITRATION: :ARBITRATION
              COLLABORATION: :COLLABORATION

