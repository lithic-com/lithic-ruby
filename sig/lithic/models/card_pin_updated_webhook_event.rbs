        pin_status: Lithic::Models::CardPinUpdatedWebhookEvent::pin_status,
        status_reason: Lithic::Models::CardPinUpdatedWebhookEvent::status_reason
      }

      type pin_status = :OK | :BLOCKED

      module PinStatus
        extend Lithic::Internal::Type::Enum

        OK: :OK
