module Lithic
  module Resources
    class Tokenizations
      def create: (
        String card_token,
        agent_token: String,
        type: Lithic::Models::TokenizationCreateParams::type_,
        ?request_options: Lithic::request_opts
      ) -> Lithic::Tokenization

      def retrieve: (
        String tokenization_token,
        ?request_options: Lithic::request_opts
      ) -> Lithic::Tokenization

      def list: (
        ?account_token: String,
        ?begin_: Date,
        ?card_token: String,
        ?end_: Date,
        ?ending_before: String,
        ?page_size: Integer,
        ?starting_after: String,
        ?tokenization_channel: Lithic::Models::TokenizationListParams::tokenization_channel,
        ?request_options: Lithic::request_opts
      ) -> Lithic::Internal::CursorPage[Lithic::Tokenization]

      def activate: (
        String tokenization_token,
        ?request_options: Lithic::request_opts
      ) -> nil

      def create_payment_credentials: (
        String tokenization_token,
        device: Lithic::TokenizationCreatePaymentCredentialsParams::Device,
        mandate: Lithic::TokenizationCreatePaymentCredentialsParams::Mandate,
        type: Lithic::Models::TokenizationCreatePaymentCredentialsParams::type_,
        ?request_options: Lithic::request_opts
      ) -> Lithic::Models::TokenizationCreatePaymentCredentialsResponse

      def deactivate: (
        String tokenization_token,
        ?request_options: Lithic::request_opts
      ) -> nil

      def pause: (
        String tokenization_token,
        ?request_options: Lithic::request_opts
      ) -> nil

      def resend_activation_code: (
        String tokenization_token,
        ?activation_method_type: Lithic::Models::TokenizationResendActivationCodeParams::activation_method_type,
        ?request_options: Lithic::request_opts
      ) -> nil

      def select_tfa_method: (
        String tokenization_token,
        method_: Lithic::Models::TokenizationSelectTfaMethodParams::method_,
        ?request_options: Lithic::request_opts
      ) -> Lithic::Models::TokenizationSelectTfaMethodResponse

      def simulate: (
        cvv: String,
        expiration_date: String,
        pan: String,
        tokenization_source: Lithic::Models::TokenizationSimulateParams::tokenization_source,
        ?account_score: Integer,
        ?device_score: Integer,
        ?entity: String,
        ?wallet_recommended_decision: Lithic::Models::TokenizationSimulateParams::wallet_recommended_decision,
        ?request_options: Lithic::request_opts
      ) -> Lithic::Tokenization

      def submit_tfa: (
        String tokenization_token,
        value: String,
        ?request_options: Lithic::request_opts
      ) -> Lithic::Models::TokenizationSubmitTfaResponse

      def unpause: (
        String tokenization_token,
        ?request_options: Lithic::request_opts
      ) -> nil

      def update_digital_card_art: (
        String tokenization_token,
        ?digital_card_art_token: String,
        ?request_options: Lithic::request_opts
      ) -> Lithic::Tokenization

      def initialize: (client: Lithic::Client) -> void
    end
  end
end
